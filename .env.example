# Variable names only: set them in your shell environment (never commit real values).
ANTHROPIC_API_KEY=
# Optional overrides (defaults in parentheses)
PM_MODEL=                # claude-sonnet-5-5
PM_SYNTH_MODEL=          # same as PM_MODEL
PM_DB_PATH=              # %LOCALAPPDATA%/pm-assistant/pm.db; else $XDG_DATA_HOME or ~/.local/share/...
PM_SEED_DIR=             # data/seed
PM_CORPUS_DIR=           # data/corpus
PM_MCP_SERVER_CMD=       # JSON array, e.g. ["python", "-m", "pm_assistant.mcp_server"]
PM_MCP_TIMEOUT_S=        # 60
PM_RAG_K=                # 4
PM_KG_HOPS=              # 2
